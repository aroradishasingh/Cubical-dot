# Copy this file to .env.local for local development, and set the same
# values in Vercel → Project Settings → Environment Variables for production.

# Required. Create a free account at https://resend.com, then
# Dashboard → API Keys → Create API Key. Paste it here.
RESEND_API_KEY=

# Optional. Who the contact-form email appears to come from.
# The default below works immediately with no setup, because it only
# sends to the Resend account's own email address (see CONTACT_TO_EMAIL).
# Once you verify the cubicaldot.com domain in Resend (Dashboard → Domains),
# change this to something like: Cubical Dot <contact@cubicaldot.com>
RESEND_FROM_EMAIL=Cubical Dot <onboarding@resend.dev>

# Optional. Where contact-form submissions are delivered. Defaults to
# mayank@cubicaldot.com if not set. Must match the email you signed up to
# Resend with, unless you've verified a sending domain.
CONTACT_TO_EMAIL=mayank@cubicaldot.com
