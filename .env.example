# Copy this file to .env.local for local development, and set the same
# values in Vercel → Project Settings → Environment Variables for production.

# Required. Create a free account at https://resend.com, then
# Dashboard → API Keys → Create API Key. Paste it here.
RESEND_API_KEY=

# Optional. Who the contact-form email appears to come from.
# The default below works immediately with no setup, because it only
# sends to the Resend account's own email address (see CONTACT_TO_EMAIL).
# Once you verify the cubicaldot.com domain in Resend (Dashboard → Domains),
# change this to something like: Cubical Dot <contact@cubicaldot.com>
RESEND_FROM_EMAIL=Cubical Dot <onboarding@resend.dev>

# Optional. Where contact-form submissions are delivered. Defaults to
# mayank@cubicaldot.com if not set. Must match the email you signed up to
# Resend with, unless you've verified a sending domain.
CONTACT_TO_EMAIL=mayank@cubicaldot.com

# Optional. Google Analytics 4 (gated behind the cookie banner - see
# src/components/analytics.tsx and src/components/cookie-consent.tsx).
# Already defaults to the studio's own property (G-LRYWB8HNBX) if left
# blank. Only set this to point at a different GA4 property - get the
# value from analytics.google.com: Admin -> Create Property -> Web data
# stream -> copy the "Measurement ID" (starts with G-). Set it to the
# literal string "" to disable analytics entirely (e.g. in preview deploys).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional. Proves to Google Search Console that you own this site, so you
# can see search performance, submit the sitemap, and request indexing.
# Get this from search.google.com/search-console: Add property ->
# cubicaldot.com -> "HTML tag" verification method -> copy the content="..."
# value only (not the whole <meta> tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional. Same idea for Bing/Microsoft (which also powers Yahoo search and
# some of DuckDuckGo). Get this from bing.com/webmasters: Add a site ->
# "Add a meta tag" verification -> copy the content="..." value only.
NEXT_PUBLIC_BING_SITE_VERIFICATION=
